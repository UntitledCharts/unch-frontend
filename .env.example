PUBLIC_API_URL=https://api.example.com
# where the API serves files from (the backend's storage public_url); the proxies and /cdn only fetch from here
PUBLIC_CDN_URL=https://cdn.example.com
# host only, no https://
PUBLIC_SONOLUS_HOST=example.com
# where this site is deployed
PUBLIC_SITE_URL=http://localhost:5173
# port `bun run start` listens on
PORT=3001
# public URL of the site, same as PUBLIC_SITE_URL in production
ORIGIN=http://localhost:3001
# Google AdSense publisher id (ca-pub-...) and ad slot; leave either empty to turn ads off
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT=
